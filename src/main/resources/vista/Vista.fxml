<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefWidth="1280" prefHeight="820" stylesheets="@estilos.css"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.dataforge.controlador.ControladorVista">

    <!-- CABECERA -->
    <top>
        <HBox spacing="20" alignment="CENTER_LEFT" styleClass="cabecera">
            <Label text="DATAFORGE - Gestor de Procesos (RA1)" styleClass="titulo"/>
            <Label fx:id="lblResumenCabecera" text="Listo para ejecutar" styleClass="estado"/>
        </HBox>
    </top>

    <!-- CENTRO -->
    <center>
        <VBox spacing="12" style="-fx-padding: 15;">

            <!-- FILA DE CONFIGURACIÓN (4 BLOQUES BÁSICOS) -->
            <HBox spacing="12">

                <!-- 1. TAREA -->
                <VBox spacing="8" HBox.hgrow="ALWAYS" styleClass="panel">
                    <Label text="1. TAREA" styleClass="subtitulo"/>
                    <ComboBox fx:id="comboTareas" maxWidth="Infinity"/>
                    <Label fx:id="lblDescripcionTarea" wrapText="true" text="Selecciona una tarea..."/>
                    <Button fx:id="btnLimpiarTabla" text="Limpiar tabla" maxWidth="Infinity"/>
                </VBox>

                <!-- 2. PARÁMETROS -->
                <VBox spacing="8" HBox.hgrow="ALWAYS" styleClass="panel">
                    <Label text="2. PARÁMETROS" styleClass="subtitulo"/>

                    <VBox fx:id="boxFicheroEntrada" spacing="5">
                        <Label text="Fichero de entrada:"/>
                        <HBox spacing="5">
                            <TextField fx:id="txtRutaFichero" HBox.hgrow="ALWAYS" promptText="archivo.txt"/>
                            <Button fx:id="btnExaminarEntrada" text="Buscar"/>
                        </HBox>
                    </VBox>

                    <VBox fx:id="boxTextoStdin" spacing="5" visible="false" managed="false">
                        <Label text="Texto para stdin:"/>
                        <TextArea fx:id="txtContenidoStdin" prefHeight="55" wrapText="true"/>
                    </VBox>

                    <VBox fx:id="boxLimiteN" spacing="5" visible="false" managed="false">
                        <Label text="Límite N (primos):"/>
                        <TextField fx:id="txtLimiteN" text="200000"/>
                    </VBox>

                    <VBox fx:id="boxPalabraBuscar" spacing="5">
                        <Label text="Palabra a buscar:"/>
                        <TextField fx:id="txtPalabra" promptText="proceso"/>
                    </VBox>
                </VBox>

                <!-- 3. EJECUCIÓN -->
                <VBox spacing="8" HBox.hgrow="ALWAYS" styleClass="panel">
                    <Label text="3. EJECUCIÓN" styleClass="subtitulo"/>
                    <ComboBox fx:id="comboModo" maxWidth="Infinity"/>
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <Label text="Procesos (1-100):"/>
                        <Spinner fx:id="spinnerProcesos" prefWidth="80" editable="true"/>
                    </HBox>
                    <Button fx:id="btnIniciar" text="▶ Iniciar" maxWidth="Infinity" styleClass="btn-iniciar"/>
                    <Button fx:id="btnDetener" text="■ Detener (destroy)" maxWidth="Infinity" styleClass="btn-detener"/>
                </VBox>

                <!-- 4. REDIRECCIONES -->
                <VBox spacing="6" HBox.hgrow="ALWAYS" styleClass="panel">
                    <Label text="4. REDIRECCIONES" styleClass="subtitulo"/>
                    <HBox spacing="5" alignment="CENTER_LEFT">
                        <Label text="stdout:" prefWidth="45"/>
                        <ComboBox fx:id="comboStdout" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                        <Button fx:id="btnFicheroStdout" text="..." disable="true"/>
                    </HBox>
                    <Label fx:id="lblRutaStdout" text="PIPE (DataForge)"/>

                    <HBox spacing="5" alignment="CENTER_LEFT">
                        <Label text="stderr:" prefWidth="45"/>
                        <ComboBox fx:id="comboStderr" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                        <Button fx:id="btnFicheroStderr" text="..." disable="true"/>
                    </HBox>
                    <Label fx:id="lblRutaStderr" text="PIPE (DataForge)"/>

                    <HBox spacing="5" alignment="CENTER_LEFT">
                        <Label text="stdin:" prefWidth="45"/>
                        <ComboBox fx:id="comboStdin" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                        <Button fx:id="btnFicheroStdin" text="..." disable="true"/>
                    </HBox>
                    <Label fx:id="lblRutaStdin" text="Argumento fichero"/>
                </VBox>
            </HBox>

            <!-- TABLA DE PROCESOS -->
            <VBox spacing="6" VBox.vgrow="ALWAYS" styleClass="panel">
                <Label text="5. MONITOR DE PROCESOS" styleClass="subtitulo"/>
                <TableView fx:id="tablaProcesos" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colId" text="ID" prefWidth="45"/>
                        <TableColumn fx:id="colPid" text="PID" prefWidth="75"/>
                        <TableColumn fx:id="colTarea" text="Tarea" prefWidth="150"/>
                        <TableColumn fx:id="colModo" text="Modo" prefWidth="95"/>
                        <TableColumn fx:id="colParametros" text="Parámetros" prefWidth="280"/>
                        <TableColumn fx:id="colInicio" text="Inicio" prefWidth="100"/>
                        <TableColumn fx:id="colFin" text="Fin" prefWidth="100"/>
                        <TableColumn fx:id="colDuracion" text="Tiempo (ms)" prefWidth="95"/>
                        <TableColumn fx:id="colExitCode" text="Salida" prefWidth="75"/>
                        <TableColumn fx:id="colEstado" text="Estado" prefWidth="130"/>
                    </columns>
                </TableView>
            </VBox>

            <!-- SALIDAS Y RESUMEN -->
            <SplitPane dividerPositions="0.38, 0.76" prefHeight="200">
                <VBox spacing="5" styleClass="panel">
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="STDOUT" styleClass="subtitulo"/>
                        <Button fx:id="btnLimpiarStdout" text="Limpiar"/>
                    </HBox>
                    <TextArea fx:id="txtStdout" editable="false" VBox.vgrow="ALWAYS" wrapText="true"/>
                </VBox>

                <VBox spacing="5" styleClass="panel">
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="STDERR" styleClass="subtitulo"/>
                        <Button fx:id="btnLimpiarStderr" text="Limpiar"/>
                    </HBox>
                    <TextArea fx:id="txtStderr" editable="false" VBox.vgrow="ALWAYS" wrapText="true"/>
                </VBox>

                <VBox spacing="6" styleClass="panel">
                    <Label text="RESUMEN" styleClass="subtitulo"/>
                    <HBox spacing="5"><Label text="Ejecutados:"/><Label fx:id="lblTotalEjecutados" text="0"/></HBox>
                    <HBox spacing="5"><Label text="Finalizados:"/><Label fx:id="lblFinalizados" text="0"/></HBox>
                    <HBox spacing="5"><Label text="En ejecución:"/><Label fx:id="lblEnEjecucion" text="0"/></HBox>
                    <HBox spacing="5"><Label text="Errores/Cancelados:"/><Label fx:id="lblConError" text="0"/></HBox>
                    <Label fx:id="lblTiempoLote" text="Tiempo total: 0 ms"/>
                    <ProgressBar fx:id="barraProgreso" maxWidth="Infinity" progress="0.0"/>
                </VBox>
            </SplitPane>
        </VBox>
    </center>

    <!-- PIE -->
    <bottom>
        <HBox styleClass="cabecera">
            <Label fx:id="lblEstadoBarra" text="Modo: Individual | Procesos: 1"/>
        </HBox>
    </bottom>
</BorderPane>